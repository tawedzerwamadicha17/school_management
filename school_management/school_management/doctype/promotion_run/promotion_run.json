   "label": "School Level",
   "options": "School Level",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "academic_term",
   "fieldtype": "Link",
   "label": "Academic Term",
   "options": "School Academic Term",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "dry_run",
