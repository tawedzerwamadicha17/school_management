   "label": "Items",
   "options": "Promotion Run Item",
   "read_only": 1
  }
 ],
 "field_order": [
  "school_level",
  "academic_term",
  "dry_run",
  "status",
  "summary",
  "items"
 ],
 "naming_rule": "Expression",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Academics User",
   "read": 1,
   "report": 1
  }
 ]
