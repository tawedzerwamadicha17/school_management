{
 "doctype": "DocType",
 "name": "School Assessment Result",
 "module": "School Management",
 "custom": 0,
 "engine": "InnoDB",
 "istable": 0,
 "editable_grid": 0,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "student",
   "fieldtype": "Link",
   "label": "Student",
   "options": "School Student",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "student_name",
   "fieldtype": "Data",
   "label": "Student Name",
   "fetch_from": "student.student_name",
   "read_only": 1
  },
  {
   "fieldname": "academic_term",
   "fieldtype": "Link",
   "label": "Academic Term",
   "options": "School Academic Term",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "subject",
   "fieldtype": "Link",
   "label": "Subject",
   "options": "School Subject",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "total_score",
   "fieldtype": "Float",
   "label": "Total Score",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "maximum_score",
   "fieldtype": "Float",
   "label": "Maximum Score",
   "default": "100",
   "reqd": 1
  }
 ],
 "field_order": [
  "student",
  "student_name",
  "academic_term",
  "subject",
  "total_score",
  "maximum_score"
 ],
 "autoname": "format:SAR-{#####}",
 "naming_rule": "Expression",
 "is_submittable": 1,
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Academics User",
   "read": 1,
   "report": 1
  }
 ]
}