{
 "doctype": "DocType",
 "name": "School Student",
 "module": "School Management",
 "custom": 0,
 "engine": "InnoDB",
 "istable": 0,
 "editable_grid": 0,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "first_name",
   "fieldtype": "Data",
   "label": "First Name",
   "reqd": 1
  },
  {
   "fieldname": "middle_name",
   "fieldtype": "Data",
   "label": "Middle Name"
  },
  {
   "fieldname": "last_name",
   "fieldtype": "Data",
   "label": "Last Name"
  },
  {
   "fieldname": "student_name",
   "fieldtype": "Data",
   "label": "Student Name",
   "read_only": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "student_email_id",
   "fieldtype": "Data",
   "label": "Student Email",
   "options": "Email"
  },
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "User",
   "options": "User",
   "read_only": 1,
   "description": "LMS login. Created automatically from the email when enabled in School Management Settings"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1",
   "in_standard_filter": 1
  },
  {
   "fieldname": "current_level",
   "fieldtype": "Link",
   "label": "Current Level",
   "options": "School Level",
   "in_standard_filter": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "school_status",
   "fieldtype": "Select",
   "label": "School Status",
   "options": "Active\nGraduated\nSuspended\nInactive",
   "default": "Active",
   "in_standard_filter": 1,
   "in_list_view": 1
  }
 ],
 "field_order": [
  "first_name",
  "middle_name",
  "last_name",
  "student_name",
  "student_email_id",
  "user",
  "enabled",
  "current_level",
  "school_status"
 ],
 "autoname": "format:STU-{#####}",
 "naming_rule": "Expression",
 "title_field": "student_name",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Academics User",
   "read": 1,
   "report": 1
  }
 ]
}