  }
 ],
 "field_order": [
  "student",
  "student_name",
  "attendance_date",
  "status"
 ],
 "autoname": "format:SATT-{#####}",
 "naming_rule": "Expression",
 "is_submittable": 1,
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Academics User",
   "read": 1,
   "report": 1
  }
 ]
}